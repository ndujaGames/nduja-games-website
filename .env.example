# Server
PORT=9080
NODE_ENV=development
SITE_HOST=nduja.games
SITE_URL=https://nduja.games
SITE_BETA=false
TRUST_PROXY=true

# Public contact in legal pages (default: ndujagames@sullo.co)
CONTACT_EMAIL=ndujagames@sullo.co

# Game URLs (shown on the home page)
ABDOKU_URL=https://abdoku.nduja.games
CHROMAWELL_URL=https://chromawell.nduja.games
CHESSRELAY_URL=https://chessrelay.nduja.games

# PostgreSQL (disabled until leaderboard API is implemented)
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nduja
POSTGRES_SSL=false
