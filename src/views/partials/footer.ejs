</main>
<footer class="site-footer">
  <div class="footer-tools">
    <button type="button" class="theme-btn" id="theme-toggle" aria-label="<%= lang === 'it' ? 'Tema notte' : 'Night theme' %>" aria-pressed="false">
      <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M21 14.3A9 9 0 0 1 9.7 3a7.5 7.5 0 1 0 11.3 11.3z"/>
      </svg>
      <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="currentColor"/>
        <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 3v2.2M12 18.8V21M4.93 4.93l1.56 1.56M17.51 17.51l1.56 1.56M3 12h2.2M18.8 12H21M4.93 19.07l1.56-1.56M17.51 6.49l1.56-1.56"/>
        </g>
      </svg>
    </button>
    <div class="lang-switch" role="group" aria-label="<%= lang === 'it' ? 'Lingua' : 'Language' %>">
      <a href="<%= langPath('en') %>" class="lang-btn<%= lang === 'en' ? ' is-on' : '' %>" lang="en" hreflang="en" aria-current="<%= lang === 'en' ? 'true' : 'false' %>">EN</a>
      <a href="<%= langPath('it') %>" class="lang-btn<%= lang === 'it' ? ' is-on' : '' %>" lang="it" hreflang="it" aria-current="<%= lang === 'it' ? 'true' : 'false' %>">IT</a>
    </div>
  </div>
  <p class="site-footer-line">
    © <%= year %> <span class="brand-mark"><%= siteMark %></span><%= siteName %>
    <span class="footer-sep" aria-hidden="true">|</span>
    <span class="footer-version">v<%= appVersion %></span>
    <button type="button" class="footer-text-btn" id="site-version-update" hidden></button>
    <span class="footer-sep" aria-hidden="true">|</span>
    <a href="/<%= lang %>/terms"><%= lang === 'it' ? 'Termini' : 'Terms' %></a>
    <span class="footer-sep" aria-hidden="true">|</span>
    <a href="/<%= lang %>/privacy"><%= lang === 'it' ? 'Privacy' : 'Privacy' %></a>
    <span class="footer-sep" aria-hidden="true">|</span>
    <button type="button" class="footer-text-btn" id="cookie-open"><%= lang === 'it' ? 'Cookie' : 'Cookies' %></button>
    <span class="footer-sep" aria-hidden="true">|</span>
    <a class="footer-icon" href="https://x.com/ndujagames" rel="noreferrer" target="_blank" aria-label="X">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.72-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
      </svg>
    </a>
  </p>
</footer>
<div id="cookie-modal" class="cookie-modal">
  <div class="cookie-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title">
    <p class="cookie-consent-title" id="cookie-modal-title"><%= lang === 'it' ? 'Cookie' : 'Cookies' %></p>
    <p class="cookie-consent-body">
      <%= lang === 'it'
        ? 'Usiamo Google Analytics per capire come viene usato il sito. Solo se accetti.'
        : 'We use Google Analytics to understand how the site is used. Only if you accept.' %>
      <a href="/<%= lang %>/privacy"><%= lang === 'it' ? 'Informativa sulla privacy' : 'Privacy policy' %></a>
    </p>
    <div class="cookie-consent-actions">
      <button type="button" class="cookie-consent-reject" id="cookie-no"><%= lang === 'it' ? 'Rifiuta' : 'Reject' %></button>
      <button type="button" class="cookie-consent-accept" id="cookie-yes"><%= lang === 'it' ? 'Accetta' : 'Accept' %></button>
    </div>
  </div>
</div>
<aside id="app-update" class="app-update" hidden>
  <p class="app-update-title"><%= lang === 'it' ? 'Nuova versione' : 'New version' %></p>
  <p class="app-update-body">
    <%= lang === 'it'
      ? 'C\'è un aggiornamento importante. Ricarica la pagina.'
      : 'There\'s an important update. Reload the page.' %>
  </p>
  <div class="app-update-actions">
    <button type="button" class="app-update-reload" id="app-update-reload"><%= lang === 'it' ? 'Ricarica' : 'Reload' %></button>
  </div>
</aside>
<script src="/js/version-check.js?v=<%= assetVersion %>-ui"></script>
</body>
</html>
