<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= brandName %></title>
  <meta name="description" content="<%= brandName %> — playful games and puzzles." />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= brandName %>" />
  <meta property="og:title" content="<%= title %> · <%= brandName %>" />
  <meta property="og:description" content="<%= brandName %> — playful games and puzzles." />
  <meta property="og:url" content="<%= siteUrl %><%= typeof path === 'string' ? path : '' %>" />
  <meta property="og:image" content="<%= siteUrl %>/og.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="600" />
  <meta property="og:image:alt" content="<%= brandName %> — Chromawell, ABdoku, ChessRelay, Midcoil, Hexact" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@ndujagames" />
  <meta name="twitter:title" content="<%= title %> · <%= brandName %>" />
  <meta name="twitter:description" content="<%= brandName %> — playful games and puzzles." />
  <meta name="twitter:image" content="<%= siteUrl %>/og.jpg" />
  <meta name="theme-color" content="#f4ae07" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="<%= brandName %>" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>" />
  <link rel="icon" href="/favicon.svg?v=<%= assetVersion %>" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico?v=<%= assetVersion %>" sizes="any" />
  <link rel="icon" href="/favicon.png?v=<%= assetVersion %>" type="image/png" sizes="128x128" />
  <link rel="icon" href="/favicon-32.png?v=<%= assetVersion %>" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=<%= assetVersion %>" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= assetVersion %>" sizes="180x180" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css?v=<%= assetVersion %>" />
</head>
<body>
