<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <h1 class="hero-title"><span class="hero-mark"><%= siteMark %></span><%= siteName %></h1>
  <p class="hero-lead">
    <%= lang === 'it'
      ? 'Giochi pensati per il web e per mobile — gioca offline, con funzioni online\u00a0opzionali.'
      : 'Games built for the web and mobile — play offline, with optional online\u00a0features.' %>
  </p>
</section>

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="section-title"><%= lang === 'it' ? 'Progetti' : 'Projects' %></h2>
  <ul class="project-grid">
    <% for (const project of projects) { %>
      <li class="project-card">
        <div class="project-card-layout">
        <% if (project.image) { %>
          <div class="project-shot-wrap">
            <% if (project.href) { %>
              <a href="<%= project.href %>" rel="noreferrer" target="_blank" tabindex="-1" aria-hidden="true">
                <img class="project-shot" src="<%= project.image %>" alt="<%= project.imageAlt?.[lang] || project.imageAlt?.en || project.name %>" width="390" height="844" loading="lazy" />
              </a>
            <% } else { %>
              <img class="project-shot" src="<%= project.image %>" alt="<%= project.imageAlt?.[lang] || project.imageAlt?.en || project.name %>" width="390" height="844" loading="lazy" />
            <% } %>
          </div>
        <% } %>
        <div class="project-card-body">
        <div class="project-card-head">
          <h3><%= project.name %></h3>
          <% if (project.status === 'beta') { %>
            <span class="badge">Beta</span>
          <% } else if (project.status === 'live') { %>
            <span class="badge badge-live">Live</span>
          <% } %>
        </div>
        <p class="project-description"><%= project.description[lang] || project.description.en %></p>
        <div class="project-card-foot">
          <% if (project.href) { %>
            <a class="project-link" href="<%= project.href %>" rel="noreferrer" target="_blank">
              <%= lang === 'it' ? 'Visita' : 'Visit' %> →
            </a>
          <% } else { %>
            <span class="project-soon"><%= lang === 'it' ? 'In arrivo' : 'Coming soon' %></span>
          <% } %>
        </div>
        </div>
        </div>
      </li>
    <% } %>
  </ul>
</section>

<%- include('partials/footer') %>
