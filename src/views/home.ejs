<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <h1 class="hero-title">
    <img class="hero-logo hero-logo-day" src="/img/nduja-logo.png?v=<%= assetVersion %>" alt="<%= siteMark %><%= siteName %>" width="1400" height="211" /><img class="hero-logo hero-logo-night" src="/img/nduja-logo-white.png?v=<%= assetVersion %>" alt="" width="1400" height="211" />
  </h1>
</section>

<section class="projects" aria-label="<%= lang === 'it' ? 'Giochi' : 'Games' %>">
  <ul class="project-grid">
    <% for (const project of projects) { %>
      <li class="project-card">
        <div class="project-card-head">
          <h3><%= project.name %></h3>
          <% if (project.status === 'beta') { %>
            <span class="badge">Beta</span>
          <% } else if (project.status === 'live') { %>
            <span class="badge badge-live">Live</span>
          <% } %>
        </div>
        <% if (project.image) { %>
          <figure class="project-shot-wrap">
            <% if (project.href) { %>
              <a href="<%= project.href %>" rel="noreferrer" target="_blank">
                <img class="project-shot" src="<%= project.image %>?v=<%= assetVersion %>" alt="<%= project.imageAlt?.[lang] || project.imageAlt?.en || project.name %>" loading="lazy" />
              </a>
            <% } else { %>
              <img class="project-shot" src="<%= project.image %>?v=<%= assetVersion %>" alt="<%= project.imageAlt?.[lang] || project.imageAlt?.en || project.name %>" loading="lazy" />
            <% } %>
          </figure>
        <% } %>
        <p class="project-description"><%= project.description[lang] || project.description.en %></p>
      </li>
    <% } %>
  </ul>
</section>

<%- include('partials/footer') %>
